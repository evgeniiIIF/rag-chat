# backend (FastAPI). Копировать в backend/.env при локальном запуске.
# Для docker-compose используется корневой .env (см. ../.env.example).
API_KEY=
BASE_URL=https://polza.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
LLM_MODEL=deepseek/deepseek-v3.2
CHROMA_DIR=/app/chroma_db
DATA_DIR=/app/data
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVER_K=3
SCORE_THRESHOLD=0.02
TEMPERATURE=0.0
MAX_TOKENS=500
LOG_LEVEL=INFO
