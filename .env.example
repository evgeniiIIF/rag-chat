# ==== backend (FastAPI) ====
BACKEND_API_KEY=
BACKEND_BASE_URL=https://polza.ai/api/v1
BACKEND_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
BACKEND_LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
BACKEND_CHROMA_DIR=/app/chroma_db
BACKEND_DATA_DIR=/app/data
BACKEND_CHUNK_SIZE=500
BACKEND_CHUNK_OVERLAP=100
BACKEND_RETRIEVER_K=3
BACKEND_SCORE_THRESHOLD=0.35
BACKEND_SESSION_TTL_SECONDS=86400
BACKEND_SESSION_MAX_SESSIONS=1000
BACKEND_SESSION_MAX_TURNS=30
BACKEND_TEMPERATURE=0.0
BACKEND_MAX_TOKENS=800
BACKEND_LOG_LEVEL=INFO

# ==== frontend (React/Vite) ====
VITE_API_BASE_URL=/api
VITE_APP_NAME=RAG Chat

# ==== nginx ====
NGINX_HTTP_PORT=8081

# Jina API key (для reranker, опционально)
